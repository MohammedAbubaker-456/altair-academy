# ==============================================================================
# Altair Academy — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure for your environment.
# Note: In production on GoDaddy cPanel, configure these in the "Setup Node.js App" UI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MariaDB / MySQL)
# ------------------------------------------------------------------------------
# DEVELOPMENT (Local XAMPP MariaDB):
# Default: mysql://root@127.0.0.1:3306/altair_academy (no password)
DATABASE_URL="mysql://root@127.0.0.1:3306/altair_academy"

# Read-only MongoDB source connection (used only for initial migration):
# MONGO_SOURCE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/altair?retryWrites=true&w=majority"

# PRODUCTION (GoDaddy cPanel MariaDB - local socket / localhost TCP):
# NOTE: Special characters in passwords (e.g. @, :, /, ?, #) MUST be URL-encoded (e.g. encodeURIComponent).
# DATABASE_URL="mysql://<cpanel-user>:<url-encoded-password>@localhost:3306/<cpanel-db-name>"

# ------------------------------------------------------------------------------
# 2. LOCAL DISK IMAGE UPLOAD DIRECTORY
# ------------------------------------------------------------------------------
# DEVELOPMENT:
# Optional. If omitted, defaults to <project-root>/uploads (outside src to avoid dev-server rebuilds).
# UPLOAD_DIR=""

# PRODUCTION:
# REQUIRED. Must be an ABSOLUTE path and must NOT be inside the application root (process.cwd()).
# This ensures that deploying an updated application package does NOT wipe uploaded media files.
# Example for cPanel:
# UPLOAD_DIR="/home/<cpanel-username>/altair-assets/uploads"

# ------------------------------------------------------------------------------
# 2b. PRIVATE RESUME / DOCUMENT STORAGE DIRECTORY
# ------------------------------------------------------------------------------
# DEVELOPMENT:
# Optional. If omitted, defaults to <project-root>/private-uploads (outside src to avoid dev-server rebuilds).
# PRIVATE_UPLOAD_DIR=""

# PRODUCTION:
# REQUIRED. Must be an ABSOLUTE path, outside the application root, and DIFFERENT from UPLOAD_DIR.
# Resumes are private candidate records and must NEVER be exposed publicly via /uploads or any web URL.
# Example for cPanel:
# PRIVATE_UPLOAD_DIR="/home/<cpanel-username>/altair-assets/private-uploads"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (JWT Session Signing)
# ------------------------------------------------------------------------------
# Minimum 32-character cryptographically secure random string (HS256).
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-cryptographically-secure-32-char-secret"

# ------------------------------------------------------------------------------
# 4. SITE URL (Recommended in production for canonical tags and OpenGraph)
# ------------------------------------------------------------------------------
# Set to your primary production domain (with protocol, no trailing slash).
# If unset, relative URLs are used.
SITE_URL="https://altair.academy"

# ------------------------------------------------------------------------------
# 5. INITIAL SEED CREDENTIALS (Used only by `npm run db:seed`)
# ------------------------------------------------------------------------------
# Bootstraps the first admin account into MongoDB. Change password immediately after first login.
ADMIN_EMAIL="admin@altair.academy"
ADMIN_PASSWORD="ChangeThisPasswordImmediately123!"
