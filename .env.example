# ==============================================================================
# Altair Academy - Environment Variables Template
# Copy this file to .env and fill in the values.
# ==============================================================================

# MongoDB Connection String (must be a replica set, e.g. MongoDB Atlas or local replica set)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/altair_academy?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/altair_academy?replicaSet=rs0
DATABASE_URL="mongodb://localhost:27017/altair_academy?replicaSet=rs0"

# Admin Authentication Secret (min 32 characters for secure JWT signing with jose HS256)
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-very-secure-random-32-char-string-minimum"

# Cloudinary Storage Credentials (for admin image uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Initial Admin Credentials (used only by 'npm run db:seed' to bootstrap the first administrator)
ADMIN_EMAIL="admin@altair.academy"
ADMIN_PASSWORD="ChangeThisPassword123!"
