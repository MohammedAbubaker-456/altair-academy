# ==============================================================================
# Altair Academy — Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and configure for your environment.
# Note: In production on GoDaddy cPanel, configure these in the "Setup Node.js App" UI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Replica Set Required)
# ------------------------------------------------------------------------------
# DEVELOPMENT (Native local MongoDB replica set):
# See docs/LOCAL_MONGODB_SETUP.md to configure rs0 natively without Docker.
DATABASE_URL="mongodb://127.0.0.1:27017/altair-academy?replicaSet=rs0"

# PRODUCTION (MongoDB Atlas - Europe region closest to hosting data center):
# NOTE: Special characters in passwords (e.g. @, :, /, ?, #) MUST be URL-encoded (e.g. encodeURIComponent).
# DATABASE_URL="mongodb+srv://<user>:<url-encoded-password>@<cluster>.mongodb.net/altair-academy?retryWrites=true&w=majority"

# ------------------------------------------------------------------------------
# 2. LOCAL DISK IMAGE UPLOAD DIRECTORY
# ------------------------------------------------------------------------------
# DEVELOPMENT:
# Optional. If omitted, defaults to <project-root>/uploads (outside src to avoid dev-server rebuilds).
# UPLOAD_DIR=""

# PRODUCTION:
# REQUIRED. Must be an ABSOLUTE path and must NOT be inside the application root (process.cwd()).
# This ensures that deploying an updated application package does NOT wipe uploaded media files.
# Example for cPanel:
# UPLOAD_DIR="/home/<cpanel-username>/altair-assets/uploads"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (JWT Session Signing)
# ------------------------------------------------------------------------------
# Minimum 32-character cryptographically secure random string (HS256).
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-cryptographically-secure-32-char-secret"

# ------------------------------------------------------------------------------
# 4. INITIAL SEED CREDENTIALS (Used only by `npm run db:seed`)
# ------------------------------------------------------------------------------
# Bootstraps the first admin account into MongoDB. Change password immediately after first login.
ADMIN_EMAIL="admin@altair.academy"
ADMIN_PASSWORD="ChangeThisPasswordImmediately123!"
