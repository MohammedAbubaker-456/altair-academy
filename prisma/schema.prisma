datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PRISMA CLIENT GENERATOR & TARGET PLATFORMS
// -----------------------------------------------------------------------------
// Server target placeholder: "rhel-openssl-3.0.x" (GoDaddy Web Hosting Deluxe / CloudLinux).
// Update this single place if server SSH facts (openssl version) require a different target.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Status {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ContactType {
  ADDRESS
  PHONE
  WHATSAPP
  EMAIL
  HOURS
  SOCIAL
}

enum NewsKind {
  FEATURED
  STORY
  PICK
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model LoginAttempt {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("login_attempts")
}

model MigrationLog {
  id        String   @id @default(cuid())
  name      String   @unique
  appliedAt DateTime @default(now())

  @@map("migration_logs")
}

model Category {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  short         String
  order         Int           @default(0)
  status        Status        @default(ACTIVE)
  courses       Course[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String        @id @default(cuid())
  categoryId String
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentId   String?
  parent     Subcategory?  @relation("SubcategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slug       String
  name       String
  order      Int           @default(0)
  status     Status        @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  courses    Course[]
  children   Subcategory[] @relation("SubcategoryHierarchy")

  @@unique([categoryId, slug])
  @@index([categoryId, parentId, order])
  @@index([parentId])
  @@map("subcategories")
}

model Course {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  image             String?
  categoryId        String
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId     String?
  subcategory       Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  level             String?
  duration          String
  price             String
  summary           String
  objective         String?
  content           String?
  whoShouldAttend   String?
  prerequisites     String?
  certification     String?
  notesAndEquipment String?
  classCapacity     String?
  feeDetails        String?
  courseSupport     String?
  courseNote        String?
  metaTitle         String?
  metaDescription   String?
  ogImage           String?
  isFeatured        Boolean      @default(false)
  order             Int          @default(0)
  status            Status       @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, order])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("courses")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String
  message   String
  status    LeadStatus @default(NEW)
  source    String     @default("contact-page")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("leads")
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

model CareerApplication {
  id                 String            @id @default(cuid())
  name               String
  email              String
  phone              String
  specialisation     String?
  message            String?
  resumeOriginalName String?
  resumeStoredName   String?
  resumeMime         String?
  resumeSize         Int?
  status             ApplicationStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("career_applications")
}

model TeamMember {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  instructorName    String?
  role              String
  instructorRole    String?
  shortBio          String
  fullBio           String?
  metaTitle         String?
  metaDescription   String?
  expertise         String   @default("[]")
  image             String?
  showInManagement  Boolean  @default(false)
  showInInstructors Boolean  @default(false)
  managementOrder   Int      @default(0)
  instructorOrder   Int      @default(0)
  status            Status   @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, showInManagement, managementOrder])
  @@index([status, showInInstructors, instructorOrder])
  @@map("team_members")
}

model NewsPost {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  excerpt         String
  body            String?
  kind            NewsKind
  category        String?
  tags            String   @default("[]")
  image           String?
  metaTitle       String?
  metaDescription String?
  ogImage         String?
  publishedAt     DateTime
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, kind, publishedAt])
  @@map("news_posts")
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@map("faqs")
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  company   String?
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@map("testimonials")
}

model JobOpening {
  id             String         @id @default(cuid())
  title          String
  employmentType EmploymentType @default(FULL_TIME)
  location       String
  scope          String
  summary        String
  order          Int            @default(0)
  status         Status         @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, order])
  @@map("job_openings")
}

model ContactDetail {
  id        String      @id @default(cuid())
  type      ContactType
  label     String?
  value     String
  link      String?
  order     Int         @default(0)
  status    Status      @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, type, order])
  @@map("contact_details")
}

model LegalPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  metaTitle       String?
  metaDescription String?
  body            String
  showInFooter    Boolean  @default(true)
  isCore          Boolean  @default(false)
  order           Int      @default(0)
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, order])
  @@map("legal_pages")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(cuid())
  email            String           @unique
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("footer")
  unsubscribeToken String           @unique
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

enum SessionKind {
  TRAINING
  EXAM
}

model CalendarCourse {
  id        String            @id @default(cuid())
  code      String            @unique
  name      String
  order     Int               @default(0)
  status    Status            @default(ACTIVE)
  sessions  CalendarSession[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("calendar_courses")
}

model CalendarSession {
  id        String         @id @default(cuid())
  courseId  String
  course    CalendarCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  kind      SessionKind
  level     String?
  startDate String
  endDate   String
  timeLabel String?
  location  String?
  note      String?
  status    Status         @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courseId, kind, startDate, endDate])
  @@index([status, startDate])
  @@index([courseId])
  @@map("calendar_sessions")
}

model UpcomingIntake {
  id        String   @id @default(cuid())
  title     String
  startDate String
  endDate   String
  location  String
  points    String   @default("[]")
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endDate])
  @@map("upcoming_intakes")
}

model PageSeo {
  id            String   @id @default(cuid())
  pageKey       String   @unique
  title         String?
  description   String?
  ogTitle       String?
  ogDescription String?
  ogImage       String?
  noIndex       Boolean?
  canonicalPath String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("page_seos")
}

model SiteSeo {
  id                 String   @id @default(cuid())
  key                String   @unique @default("default")
  siteName           String?
  defaultDescription String?
  defaultOgImage     String?
  twitterSite        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_seos")
}
