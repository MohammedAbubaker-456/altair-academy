datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PRISMA CLIENT GENERATOR & TARGET PLATFORMS
// -----------------------------------------------------------------------------
// Server target placeholder: "rhel-openssl-3.0.x" (GoDaddy Web Hosting Deluxe / CloudLinux).
// Update this single place if server SSH facts (openssl version) require a different target.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Status {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ContactType {
  ADDRESS
  PHONE
  WHATSAPP
  EMAIL
  HOURS
  SOCIAL
}

enum NewsKind {
  FEATURED
  STORY
  PICK
}

enum TeamPlacement {
  MANAGEMENT
  INSTRUCTOR
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model MigrationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  appliedAt DateTime @default(now())
}

model Category {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  slug          String        @unique
  name          String
  short         String
  order         Int           @default(0)
  status        Status        @default(ACTIVE)
  courses       Course[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Subcategory {
  id         String        @id @default(auto()) @map("_id") @db.ObjectId
  categoryId String        @db.ObjectId
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentId   String?       @db.ObjectId
  parent     Subcategory?  @relation("SubcategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slug       String
  name       String
  order      Int           @default(0)
  status     Status        @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  courses    Course[]
  children   Subcategory[] @relation("SubcategoryHierarchy")

  @@unique([categoryId, slug])
  @@index([categoryId, parentId, order])
  @@index([parentId])
}

model Course {
  id                String       @id @default(auto()) @map("_id") @db.ObjectId
  slug              String       @unique
  title             String
  image             String?
  categoryId        String       @db.ObjectId
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId     String?      @db.ObjectId
  subcategory       Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  level             String?
  duration          String
  price             String
  summary           String
  objective         String?
  content           String?
  whoShouldAttend   String?
  prerequisites     String?
  certification     String?
  notesAndEquipment String?
  classCapacity     String?
  feeDetails        String?
  courseSupport     String?
  courseNote        String?
  isFeatured        Boolean      @default(false)
  order             Int          @default(0)
  status            Status       @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, order])
  @@index([categoryId])
  @@index([subcategoryId])
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  message   String
  status    LeadStatus @default(NEW)
  source    String     @default("contact-page")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

model CareerApplication {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String
  phone              String
  specialisation     String?
  message            String?
  resumeOriginalName String?
  resumeStoredName   String?
  resumeMime         String?
  resumeSize         Int?
  status             ApplicationStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
}

model TeamMember {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  slug            String          @unique
  name            String
  instructorName  String?
  role            String
  instructorRole  String?
  shortBio        String
  fullBio         String?
  expertise       String[]
  image           String?
  placements      TeamPlacement[]
  managementOrder Int             @default(0)
  instructorOrder Int             @default(0)
  status          Status          @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, managementOrder])
  @@index([status, instructorOrder])
}

model NewsPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  excerpt     String
  body        String?
  kind        NewsKind
  category    String?
  tags        String[]
  image       String?
  publishedAt DateTime
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, kind, publishedAt])
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model Testimonial {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  quote     String
  name      String
  company   String?
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model JobOpening {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  employmentType EmploymentType @default(FULL_TIME)
  location       String
  scope          String
  summary        String
  order          Int            @default(0)
  status         Status         @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, order])
}

model ContactDetail {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type      ContactType
  label     String?
  value     String
  link      String?
  order     Int         @default(0)
  status    Status      @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, type, order])
}

model LegalPage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  title           String
  metaDescription String?
  body            String
  showInFooter    Boolean  @default(true)
  isCore          Boolean  @default(false)
  order           Int      @default(0)
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, order])
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  email            String           @unique
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("footer")
  unsubscribeToken String           @unique
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, subscribedAt])
}

enum SessionKind {
  TRAINING
  EXAM
}

model CalendarCourse {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  code      String            @unique
  name      String
  order     Int               @default(0)
  status    Status            @default(ACTIVE)
  sessions  CalendarSession[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}

model CalendarSession {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  courseId  String         @db.ObjectId
  course    CalendarCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  kind      SessionKind
  level     String?
  startDate String
  endDate   String
  timeLabel String?
  location  String?
  note      String?
  status    Status         @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courseId, kind, startDate, endDate])
  @@index([status, startDate])
  @@index([courseId])
}

model UpcomingIntake {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  startDate String
  endDate   String
  location  String
  points    String[]
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endDate])
}
