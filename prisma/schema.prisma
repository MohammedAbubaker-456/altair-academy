datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PRISMA CLIENT GENERATOR & TARGET PLATFORMS
// -----------------------------------------------------------------------------
// Server target placeholder: "rhel-openssl-3.0.x" (GoDaddy Web Hosting Deluxe / CloudLinux).
// Update this single place if server SSH facts (openssl version) require a different target.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Status {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ContactType {
  ADDRESS
  PHONE
  WHATSAPP
  EMAIL
  HOURS
  SOCIAL
}

enum NewsKind {
  FEATURED
  STORY
  PICK
}

model AdminUser {
  id           String   @id @default(cuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(191)
  name         String   @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

model LoginAttempt {
  id          String   @id @default(cuid()) @db.VarChar(36)
  key         String   @unique @db.VarChar(191)
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@map("login_attempts")
}

model MigrationLog {
  id        String   @id @default(cuid()) @db.VarChar(36)
  name      String   @unique @db.VarChar(191)
  appliedAt DateTime @default(now())

  @@map("migration_logs")
}

model Category {
  id            String        @id @default(cuid()) @db.VarChar(36)
  slug          String        @unique @db.VarChar(191)
  name          String        @db.VarChar(191)
  short         String        @db.VarChar(191)
  order         Int           @default(0)
  status        Status        @default(ACTIVE)
  courses       Course[]
  subcategories Subcategory[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("categories")
}

model Subcategory {
  id         String        @id @default(cuid()) @db.VarChar(36)
  categoryId String        @db.VarChar(36)
  category   Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  parentId   String?       @db.VarChar(36)
  parent     Subcategory?  @relation("SubcategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  slug       String        @db.VarChar(191)
  name       String        @db.VarChar(191)
  order      Int           @default(0)
  status     Status        @default(ACTIVE)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  courses    Course[]
  children   Subcategory[] @relation("SubcategoryHierarchy")

  @@unique([categoryId, slug])
  @@index([categoryId, parentId, order])
  @@index([parentId])
  @@map("subcategories")
}

model Course {
  id                String       @id @default(cuid()) @db.VarChar(36)
  slug              String       @unique @db.VarChar(191)
  title             String       @db.VarChar(255)
  image             String?      @db.VarChar(500)
  categoryId        String       @db.VarChar(36)
  category          Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subcategoryId     String?      @db.VarChar(36)
  subcategory       Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: Restrict)
  level             String?      @db.VarChar(100)
  duration          String       @db.VarChar(100)
  price             String       @db.VarChar(100)
  summary           String       @db.Text
  objective         String?      @db.MediumText
  content           String?      @db.MediumText
  whoShouldAttend   String?      @db.MediumText
  prerequisites     String?      @db.MediumText
  certification     String?      @db.MediumText
  notesAndEquipment String?      @db.MediumText
  classCapacity     String?      @db.VarChar(100)
  feeDetails        String?      @db.MediumText
  courseSupport     String?      @db.MediumText
  courseNote        String?      @db.MediumText
  metaTitle         String?      @db.VarChar(255)
  metaDescription   String?      @db.VarChar(500)
  ogImage           String?      @db.VarChar(500)
  isFeatured        Boolean      @default(false)
  order             Int          @default(0)
  status            Status       @default(ACTIVE)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status, order])
  @@index([categoryId])
  @@index([subcategoryId])
  @@map("courses")
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(cuid()) @db.VarChar(36)
  name      String     @db.VarChar(191)
  email     String     @db.VarChar(191)
  phone     String     @db.VarChar(100)
  message   String     @db.Text
  status    LeadStatus @default(NEW)
  source    String     @default("contact-page") @db.VarChar(100)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
  @@map("leads")
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

model CareerApplication {
  id                 String            @id @default(cuid()) @db.VarChar(36)
  name               String            @db.VarChar(191)
  email              String            @db.VarChar(191)
  phone              String            @db.VarChar(100)
  specialisation     String?           @db.VarChar(191)
  message            String?           @db.Text
  resumeOriginalName String?           @db.VarChar(255)
  resumeStoredName   String?           @db.VarChar(255)
  resumeMime         String?           @db.VarChar(100)
  resumeSize         Int?
  status             ApplicationStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
  @@map("career_applications")
}

model TeamMember {
  id                String   @id @default(cuid()) @db.VarChar(36)
  slug              String   @unique @db.VarChar(191)
  name              String   @db.VarChar(191)
  instructorName    String?  @db.VarChar(191)
  role              String   @db.VarChar(191)
  instructorRole    String?  @db.VarChar(191)
  shortBio          String   @db.Text
  fullBio           String?  @db.MediumText
  metaTitle         String?  @db.VarChar(255)
  metaDescription   String?  @db.VarChar(500)
  expertise         String   @default("[]") @db.LongText
  image             String?  @db.VarChar(500)
  showInManagement  Boolean  @default(false)
  showInInstructors Boolean  @default(false)
  managementOrder   Int      @default(0)
  instructorOrder   Int      @default(0)
  status            Status   @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status, showInManagement, managementOrder])
  @@index([status, showInInstructors, instructorOrder])
  @@map("team_members")
}

model NewsPost {
  id              String   @id @default(cuid()) @db.VarChar(36)
  slug            String   @unique @db.VarChar(191)
  title           String   @db.VarChar(255)
  excerpt         String   @db.Text
  body            String?  @db.LongText
  kind            NewsKind
  category        String?  @db.VarChar(100)
  tags            String   @default("[]") @db.LongText
  image           String?  @db.VarChar(500)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.VarChar(500)
  ogImage         String?  @db.VarChar(500)
  publishedAt     DateTime
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, kind, publishedAt])
  @@map("news_posts")
}

model Faq {
  id        String   @id @default(cuid()) @db.VarChar(36)
  question  String   @db.VarChar(500)
  answer    String   @db.MediumText
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@map("faqs")
}

model Testimonial {
  id        String   @id @default(cuid()) @db.VarChar(36)
  quote     String   @db.Text
  name      String   @db.VarChar(191)
  company   String?  @db.VarChar(191)
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
  @@map("testimonials")
}

model JobOpening {
  id             String         @id @default(cuid()) @db.VarChar(36)
  title          String         @db.VarChar(255)
  employmentType EmploymentType @default(FULL_TIME)
  location       String         @db.VarChar(191)
  scope          String         @db.VarChar(191)
  summary        String         @db.Text
  order          Int            @default(0)
  status         Status         @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, order])
  @@map("job_openings")
}

model ContactDetail {
  id        String      @id @default(cuid()) @db.VarChar(36)
  type      ContactType
  label     String?     @db.VarChar(191)
  value     String      @db.Text
  link      String?     @db.VarChar(500)
  order     Int         @default(0)
  status    Status      @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, type, order])
  @@map("contact_details")
}

model LegalPage {
  id              String   @id @default(cuid()) @db.VarChar(36)
  slug            String   @unique @db.VarChar(191)
  title           String   @db.VarChar(255)
  metaTitle       String?  @db.VarChar(255)
  metaDescription String?  @db.VarChar(500)
  body            String   @db.LongText
  showInFooter    Boolean  @default(true)
  isCore          Boolean  @default(false)
  order           Int      @default(0)
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, order])
  @@map("legal_pages")
}

enum SubscriberStatus {
  ACTIVE
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id               String           @id @default(cuid()) @db.VarChar(36)
  email            String           @unique @db.VarChar(191)
  status           SubscriberStatus @default(ACTIVE)
  source           String           @default("footer") @db.VarChar(100)
  unsubscribeToken String           @unique @db.VarChar(191)
  subscribedAt     DateTime         @default(now())
  unsubscribedAt   DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, subscribedAt])
  @@map("newsletter_subscribers")
}

enum SessionKind {
  TRAINING
  EXAM
}

model CalendarCourse {
  id        String            @id @default(cuid()) @db.VarChar(36)
  code      String            @unique @db.VarChar(100)
  name      String            @db.VarChar(255)
  order     Int               @default(0)
  status    Status            @default(ACTIVE)
  sessions  CalendarSession[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("calendar_courses")
}

model CalendarSession {
  id        String         @id @default(cuid()) @db.VarChar(36)
  courseId  String         @db.VarChar(36)
  course    CalendarCourse @relation(fields: [courseId], references: [id], onDelete: Restrict)
  kind      SessionKind
  level     String?        @db.VarChar(100)
  startDate String         @db.VarChar(50)
  endDate   String         @db.VarChar(50)
  timeLabel String?        @db.VarChar(100)
  location  String?        @db.VarChar(191)
  note      String?        @db.Text
  status    Status         @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([courseId, kind, startDate, endDate])
  @@index([status, startDate])
  @@index([courseId])
  @@map("calendar_sessions")
}

model UpcomingIntake {
  id        String   @id @default(cuid()) @db.VarChar(36)
  title     String   @db.VarChar(255)
  startDate String   @db.VarChar(50)
  endDate   String   @db.VarChar(50)
  location  String   @db.VarChar(191)
  points    String   @default("[]") @db.LongText
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, endDate])
  @@map("upcoming_intakes")
}

model PageSeo {
  id            String   @id @default(cuid()) @db.VarChar(36)
  pageKey       String   @unique @db.VarChar(100)
  title         String?  @db.VarChar(255)
  description   String?  @db.VarChar(500)
  ogTitle       String?  @db.VarChar(255)
  ogDescription String?  @db.VarChar(500)
  ogImage       String?  @db.VarChar(500)
  noIndex       Boolean?
  canonicalPath String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("page_seos")
}

model SiteSeo {
  id                 String   @id @default(cuid()) @db.VarChar(36)
  key                String   @unique @default("default") @db.VarChar(50)
  siteName           String?  @db.VarChar(191)
  defaultDescription String?  @db.VarChar(500)
  defaultOgImage     String?  @db.VarChar(500)
  twitterSite        String?  @db.VarChar(100)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("site_seos")
}
