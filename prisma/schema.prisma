datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// PRISMA CLIENT GENERATOR & TARGET PLATFORMS
// -----------------------------------------------------------------------------
// Server target placeholder: "rhel-openssl-3.0.x" (GoDaddy Web Hosting Deluxe / CloudLinux).
// Update this single place if server SSH facts (openssl version) require a different target.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

enum Status {
  ACTIVE
  INACTIVE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum ContactType {
  ADDRESS
  PHONE
  WHATSAPP
  EMAIL
  HOURS
  SOCIAL
}

enum NewsKind {
  FEATURED
  STORY
  PICK
}

enum TeamPlacement {
  MANAGEMENT
  INSTRUCTOR
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAttempt {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model MigrationLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  appliedAt DateTime @default(now())
}

model Category {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  name      String
  short     String
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  courses   Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  slug         String    @unique
  title        String
  image        String?
  categoryId   String    @db.ObjectId
  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  level        String?
  duration     String
  price        String
  summary      String
  objective    String?
  content      String?
  whoShouldAttend String?
  certification String?
  notesAndEquipment String?
  classCapacity String?
  feeDetails   String?
  courseSupport String?
  isFeatured   Boolean   @default(false)
  order        Int       @default(0)
  status       Status    @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, order])
  @@index([categoryId])
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model Lead {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  message   String
  status    LeadStatus @default(NEW)
  source    String     @default("contact-page")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, createdAt])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  REJECTED
}

model CareerApplication {
  id                 String            @id @default(auto()) @map("_id") @db.ObjectId
  name               String
  email              String
  phone              String
  specialisation     String?
  message            String?
  resumeOriginalName String?
  resumeStoredName   String?
  resumeMime         String?
  resumeSize         Int?
  status             ApplicationStatus @default(NEW)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status, createdAt])
}

model TeamMember {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  slug            String          @unique
  name            String
  instructorName  String?
  role            String
  instructorRole  String?
  shortBio        String
  fullBio         String?
  expertise       String[]
  image           String?
  placements      TeamPlacement[]
  managementOrder Int             @default(0)
  instructorOrder Int             @default(0)
  status          Status          @default(ACTIVE)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status, managementOrder])
  @@index([status, instructorOrder])
}

model NewsPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  title       String
  excerpt     String
  body        String?
  kind        NewsKind
  category    String?
  tags        String[]
  image       String?
  publishedAt DateTime
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, kind, publishedAt])
}

model Faq {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  question  String
  answer    String
  order     Int      @default(0)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, order])
}

model JobOpening {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  employmentType EmploymentType @default(FULL_TIME)
  location       String
  scope          String
  summary        String
  order          Int            @default(0)
  status         Status         @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, order])
}

model ContactDetail {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  type      ContactType
  label     String?
  value     String
  link      String?
  order     Int         @default(0)
  status    Status      @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, type, order])
}

model LegalPage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  slug            String   @unique
  title           String
  metaDescription String?
  body            String
  showInFooter    Boolean  @default(true)
  isCore          Boolean  @default(false)
  order           Int      @default(0)
  status          Status   @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, order])
}

